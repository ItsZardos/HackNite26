{
  "manifest_version": 3,
  "name": "Undertone — a score for every story",
  "version": "1.7.5",
  "description": "Read immersively with a Gemini-scored soundtrack that follows your scroll.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8787/*",
    "file:///*"
  ],
  "action": {
    "default_title": "Read with Undertone",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "public/brand/icon-16.png",
      "32": "public/brand/icon-32.png",
      "48": "public/brand/icon-48.png",
      "128": "public/brand/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' http://127.0.0.1:8787 file:"
  },
  "icons": {
    "16": "public/brand/icon-16.png",
    "32": "public/brand/icon-32.png",
    "48": "public/brand/icon-48.png",
    "128": "public/brand/icon-128.png"
  }
}
